# WhatsApp Bot Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.

# ─── Pflichtfelder ──────────────────────────────────────────

# Name der WhatsApp-Gruppe, die der Bot überwachen soll
BOT_GROUP_NAME=Lab Paper Chat

# Pfad zum shared-disk-Ordner für .ris und .pdf Dateien
# WICHTIG: Immer FORWARD SLASHES verwenden (Node.js kommt damit klar)
# Linux:  /mnt/labdata/PaperBot/outbox
# Windows: //SERVER/LabData/PaperBot/outbox
# Windows: C:/Users/DeinName/PaperBot/outbox
OUTBOX_DIR=//SERVER/LabData/PaperBot/outbox

# ─── Crossref (empfohlen) ──────────────────────────────────

# Deine Email – für Rate-Limits der Crossref API
CROSSREF_MAIL=dein.name@uni.de

# ─── PDF Auto Import für EndNote (optional) ────────────────

# Pfad zu EndNote's PDF Auto Import Ordner
# In EndNote: Edit -> Preferences -> PDF Handling -> Enable automatic importing
# Leer lassen = PDFs werden nicht extra kopiert
PDF_AUTO_IMPORT_DIR=//SERVER/LabData/PaperBot/pdf-import

# ─── KI-Zusammenfassungen (optional) ──────────────────────

# Ohne LLM: Bot postet den Abstract aus Crossref
# Mit LLM: richtige Zusammenfassung (OpenAI, DeepSeek, ...)
# LLM_API_KEY=sk-proj-abcdef123456
# LLM_MODEL=gpt-4o-mini
# LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
