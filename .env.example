# WhatsApp Bot Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.

# ─── Pflichtfelder ──────────────────────────────────────────

# Name der WhatsApp-Gruppe, die der Bot überwachen soll
# Z.B. "Lab Paper Chat"
BOT_GROUP_NAME=""

# WOHIN die .ris und .pdf Dateien geschrieben werden
# Wenn Bot + EndNote auf demselben Windows-Rechner: "./data/outbox"
# Wenn Bot auf Linux: Pfad zum geteilten Ordner (z.B. OneDrive, Netzlaufwerk)
OUTBOX_DIR="./data/outbox"

# ─── Crossref (empfohlen) ──────────────────────────────────

# Deine Email – wird beim Crossref-API-Aufruf mitgeschickt
# Crossref nutzt das für Rate Limits und um dich zu kontaktieren
# Z.B. "dein.name@uni.de"
CROSSREF_MAIL=""

# ─── EndNote PDF Auto Import (optional) ───────────────────

# Vollständiger Pfad zu EndNote's PDF Auto Import Ordner
# In EndNote: Edit → Preferences → PDF Handling → Enable automatic importing
# Dort siehst du den Pfad. Kopier ihn hier rein.
# Z.B. "C:\Users\DeinName\EndNote PDF Import"
# Oder auf Linux: "/mnt/shared/pdf-import"
# Leer lassen = nicht nutzen
PDF_AUTO_IMPORT_DIR=""

# ─── LLM für Zusammenfassungen (optional) ─────────────────

# Ohne LLM: Bot postet den Abstract aus Crossref (reicht meistens)
# Mit LLM: Bot postet eine echte Zusammenfassung (OpenAI, DeepSeek, etc.)
# Format: OpenAI-kompatible API
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_ENDPOINT="https://api.openai.com/v1/chat/completions"
