# WhatsApp bot config
BOT_GROUP_NAME="Lab Paper Chat"        # Name of the WhatsApp group to monitor
BOT_GROUP_ID=""                         # OR set the exact group ID (takes priority)

# Output
OUTBOX_DIR="./data/outbox"              # RIS files + PDFs go here. Watch this folder for EndNote auto-import.
PDF_AUTO_IMPORT_DIR=""                  # Optional: EndNote's PDF Auto Import folder path (copy PDFs here too)

# LLM summary (optional -- leave empty to use abstract instead)
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"                 # or "claude-3-haiku", "deepseek-chat", etc.
LLM_ENDPOINT="https://api.openai.com/v1/chat/completions"

# Crossref (optional, for higher rate limits)
CROSSREF_MAIL="your@email.com"          # Your email so Crossref can contact you if needed
